{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByteLab",
  "version": "0.1.0",
  "identifier": "cc.playfairs.bytelab",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ByteLab",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "msi"],
    "icon": [
      "./brand/bytelab.png",
      "./brand/bytelab.ico",
      "./brand/bytelab.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    }
  }
}
