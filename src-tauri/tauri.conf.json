{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByteLab",
  "version": "0.1.0",
  "identifier": "cc.playfairs.bytelab",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ByteLab",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/bytelab.png",
      "../public/bytelab.ico",
      "../public/bytelab.icns"
    ]
  }
}
